# SENTINEL runs entirely through local Ollama.
# No API key or cloud provider configuration is required.
#
# Start Ollama and install the baseline models:
#   ollama pull gemma3:1b
#   ollama pull qwen2.5-coder:1.5b

# Lưu trữ huấn luyện trên Windows: script use-training-storage.ps1 nạp các
# biến này vào shell huấn luyện. App Vite không tự áp dụng chúng cho Python.
# Chỉ IPI_TRAINING_ROOT được ghi ở cấp User; PATH/TEMP/cache khác chỉ theo shell.
IPI_TRAINING_ROOT=E:\IPI-Training
# IPI_TRAINING_PYTHON=E:\IPI-Training\venvs\verifier\Scripts\python.exe
# HF_HOME=E:\IPI-Training\cache\huggingface
# HF_HUB_CACHE=E:\IPI-Training\cache\huggingface\hub
# HF_DATASETS_CACHE=E:\IPI-Training\cache\huggingface\datasets
# HF_ASSETS_CACHE=E:\IPI-Training\cache\huggingface\assets
# HF_XET_CACHE=E:\IPI-Training\cache\huggingface\xet
# PIP_CACHE_DIR=E:\IPI-Training\cache\pip
# UV_CACHE_DIR=E:\IPI-Training\cache\uv
# UV_PYTHON_INSTALL_DIR=E:\IPI-Training\python
# UV_PYTHON_BIN_DIR=E:\IPI-Training\tools\python-bin
# UV_TOOL_DIR=E:\IPI-Training\tools\uv-tools
# UV_TOOL_BIN_DIR=E:\IPI-Training\tools\bin
# TORCH_HOME=E:\IPI-Training\cache\torch
# TORCH_EXTENSIONS_DIR=E:\IPI-Training\cache\torch-extensions
# TRITON_CACHE_DIR=E:\IPI-Training\cache\triton
# PYTHONPYCACHEPREFIX=E:\IPI-Training\cache\pycache
# PYTHONUSERBASE=E:\IPI-Training\cache\python-user
# PYTHONNOUSERSITE=1
# PIP_REQUIRE_VIRTUALENV=true
# IPI_WEIGHTS_DIR=E:\IPI-Training\weights
# IPI_ADAPTERS_DIR=E:\IPI-Training\adapters
# IPI_CHECKPOINTS_DIR=E:\IPI-Training\checkpoints
# IPI_TRAINING_LOG_DIR=E:\IPI-Training\logs
# IPI_TRAINING_RESULTS_DIR=E:\IPI-Training\results
# TEMP=E:\IPI-Training\tmp
# TMP=E:\IPI-Training\tmp
# VIRTUAL_ENV=E:\IPI-Training\venvs\verifier (PATH chỉ prepend Scripts trong shell)
# OLLAMA_MODELS=E:\Ollama\models (cấu hình Ollama User hiện có, không tự đổi qua Vite)
